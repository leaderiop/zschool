# Reference only — the real values live in infra/remote-cache/.env.fly (gitignored)
# and as Fly secrets (`flyctl secrets list -a zschool-turbo-cache`). Never commit real values.
#
# Regenerate TURBO_TOKEN / TURBO_REMOTE_CACHE_SIGNATURE_KEY with:
#   openssl rand -hex 32

# Auth: shared secret turbo clients (local + CI) authenticate with
TURBO_TOKEN=

# Signs/verifies cache artifacts so a compromised network path can't feed
# tampered build output back into turbo — required client-side too
# (turbo.json's remoteCache.signature: true)
TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# Storage: Tigris (S3-compatible), provisioned via
#   flyctl storage create -a zschool-turbo-cache
STORAGE_PROVIDER=s3
STORAGE_PATH=zschool-turbo-cache-storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_ENDPOINT=https://fly.storage.tigris.dev

PORT=3000
NODE_ENV=production
