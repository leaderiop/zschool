# Copy to .env on the host running docker-compose (never commit the real .env)
MINIO_ROOT_USER=zschool-cache
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-value
S3_BUCKET=turbo-cache

# TURBO_TOKEN: the shared secret CI/devs authenticate with (generate: openssl rand -hex 32)
TURBO_TOKEN=change-me-to-a-long-random-value

# TURBO_REMOTE_CACHE_SIGNATURE_KEY: signs cache artifacts so the self-hosted
# server can't be fed tampered build output (generate: openssl rand -hex 32)
TURBO_REMOTE_CACHE_SIGNATURE_KEY=change-me-to-a-long-random-value
