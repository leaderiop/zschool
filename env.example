# Migration-only (neondb_owner) — never use for application queries, see packages/db/src/AppSql.ts
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler/dbname?sslmode=require
# Least-privilege runtime role (SELECT/INSERT/UPDATE/DELETE only) every application query and BDD scenario connects as.
# Created via plain SQL (migration 0007), not `neonctl roles create` — does NOT carry BYPASSRLS, so `tenant_isolation`
# RLS policies are an actually-enforced backstop for this role (see AppSql.ts, spec/stack.md risk 10 — resolved).
APP_DATABASE_URL=postgresql://zschool_service:password@host/dbname?sslmode=require
# Only needed the first time migration 0007 runs against a database that doesn't have zschool_service yet.
APP_ROLE_PASSWORD=
NEON_PROJECT_ID=
