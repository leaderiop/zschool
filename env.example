# Migration-only (neondb_owner) — never use for application queries, see packages/db/src/AppSql.ts
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler/dbname?sslmode=require
# Least-privilege runtime role (SELECT/INSERT/UPDATE/DELETE only) every application query and BDD scenario connects as.
# Also carries BYPASSRLS on Neon today (every project role does; not alterable by the project owner — see AppSql.ts),
# so this split is real least-privilege hygiene but not yet an enforced RLS backstop (spec/stack.md risk 10).
APP_DATABASE_URL=postgresql://zschool_app:password@host/dbname?sslmode=require
NEON_PROJECT_ID=
