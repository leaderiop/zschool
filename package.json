{
  "name": "zschool",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.0 <23.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "dotenv -c -- turbo run test",
    "test:bdd": "dotenv -c -- vitest run --project bdd",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect-cucumber/gherkin": "^0.9.0",
    "@effect-cucumber/vitest": "^0.9.0",
    "@effect/platform-node": "4.0.0-rc.113",
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.113",
    "@qadi/core": "0.5.0",
    "@qadi/testing": "0.5.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@zschool/db": "workspace:*",
    "@zschool/domain": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "dprint": "^0.57.4",
    "effect": "4.0.0-rc.113",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "effect": "4.0.0-rc.113",
      "@effect/platform-node-shared": "4.0.0-rc.113"
    }
  }
}
