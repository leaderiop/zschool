{
  "name": "@zschool/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "lint": "oxlint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:rls": "dotenv -e ../../.env -c -- vitest run --config vitest.rls.config.ts",
    "migrate": "dotenv -e ../../.env -c -- tsx src/runMigrations.ts"
  },
  "dependencies": {
    "effect": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "tsx": "^4.20.6"
  }
}
